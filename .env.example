# Render sets PORT automatically; use 3000 only for local development.
PORT=3000
HOST=0.0.0.0
# Private sidecar address inside the same Render container.
CORE_BIND=127.0.0.1:7070
CORE_URL=http://127.0.0.1:7070
LOG_LEVEL=info
# Set this to the real public HTTPS URL, for example https://your-service.onrender.com.
# It is used for canonical tags, Open Graph URLs, robots.txt, and sitemap.xml.
PUBLIC_SITE_URL=https://your-public-domain.example
# Optional persistent path for recent attributed news items.
NEWS_DB_FILE=./data/news-items.json
# Optional additional permissioned feeds: Name|HTTPS URL|category|official;...
NEWS_RSS_FEEDS=
# Optional owner-configured sponsored tile shown between search results.
# Use an HTTPS landing page and clearly label it; leave blank to disable.
SEARCH_AD_URL=
SEARCH_AD_LABEL=Sponsored
SEARCH_AD_TITLE=
SEARCH_AD_DESCRIPTION=
SEARCH_AD_IMAGE=
# First-party campaigns rotate automatically. Override with a JSON array of
# {id,title,description,url,image,label,weight,enabled} objects if needed.
FIRST_PARTY_CAMPAIGNS_ENABLED=true
FIRST_PARTY_CAMPAIGNS_JSON=

# Owner-only global ad controls. Set these in Render Environment, not in git.
ADMIN_PASSWORD=replace-with-a-long-random-password
AD_URL=https://your-domain.example/your-ad.mp4
AD_DURATION_SECONDS=5
UPSTREAM_COMMIT=replace-with-pinned-moviebox-tui-commit
# Optional Stremio-compatible direct HTTP/HLS add-on manifests (HTTPS, semicolon-separated).
STREAM_ADDON_MANIFESTS=
# Optional full WhatsApp chat link, for example https://wa.me/1234567890
SOCIAL_WHATSAPP_URL=
# Optional server-side AI default. The UI also accepts a user's own key and
# any OpenAI-compatible endpoint (OpenAI, xAI, OpenRouter, Ollama, LM Studio, etc.).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
