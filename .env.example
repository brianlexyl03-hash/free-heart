# Render sets PORT automatically; use 3000 only for local development.
PORT=3000
HOST=0.0.0.0
# Private sidecar address inside the same Render container.
CORE_BIND=127.0.0.1:7070
CORE_URL=http://127.0.0.1:7070
LOG_LEVEL=info

# Owner-only global ad controls. Set these in Render Environment, not in git.
ADMIN_PASSWORD=replace-with-a-long-random-password
AD_URL=https://your-domain.example/your-ad.mp4
AD_DURATION_SECONDS=5
UPSTREAM_COMMIT=replace-with-pinned-moviebox-tui-commit
# Optional full WhatsApp chat link, for example https://wa.me/1234567890
SOCIAL_WHATSAPP_URL=
# Optional server-side AI default. The UI also accepts a user's own key and
# any OpenAI-compatible endpoint (OpenAI, xAI, OpenRouter, Ollama, LM Studio, etc.).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
